{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60,
      "includeFiles": "assets/**"
    }
  },
  "crons": [
    { "path": "/api/daily-stats", "schedule": "30 8 * * *" }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    }
  ]
}
